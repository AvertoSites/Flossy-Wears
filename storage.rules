rules_version = '2';

// Deploy via `firebase deploy --only storage`. Product photography and
// shopper review photos.
service firebase.storage {
  match /b/{bucket}/o {

    // Same source of truth as firestore.rules and the admin UI: the
    // users/{uid}.role field, read cross-service. (Nothing in this project
    // sets an `admin` custom claim, so a token-claim check rejected every
    // real admin.) Needs the Storage service agent's Firestore access, which
    // the CLI offers to grant on the first `firebase deploy --only storage`.
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public product photos: anyone can view (they're rendered on the public
    // storefront), only an admin can upload/replace/delete. Capped at 10MB,
    // images only.
    match /product-images/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Shopper review photos. The browser re-encodes each one to a ≤1600px
    // JPEG before upload (see compressReviewImage), so 3MB is generous.
    // Shoppers can only create files in their own folder — never read,
    // overwrite or delete. Nothing here is publicly readable: when an admin
    // publishes the review, the server (Admin SDK, bypasses these rules)
    // mints download-token URLs; hiding it again revokes them.
    match /review-images/{uid}/{reviewId}/{fileName} {
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 3 * 1024 * 1024 &&
        request.resource.contentType == 'image/jpeg';
      allow read, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
